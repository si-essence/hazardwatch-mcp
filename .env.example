# Optional. 32 letters or digits from https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Sent only in the FIRMS URL path. Never printed. EONET tools work without it.
FIRMS_MAP_KEY=

# FIRMS origin. No userinfo, query, or hash.
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# EONET v3 origin. No key.
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3

# Contact embedded in the User-Agent. Must not be the MAP_KEY.
HAZARDWATCH_CONTACT=you@example.com

# Local FIRMS transaction budget for each 10-minute window. Cannot exceed 5000.
FIRMS_TRANSACTIONS_PER_10_MIN=5000

# Local EONET sliding window.
EONET_PER_MINUTE=30

# Cache TTL in seconds. 0 disables caching. Cache hits do not spend the local limit.
HAZARDWATCH_CACHE_TTL_SEC=60

# Upstream timeout in milliseconds.
HAZARDWATCH_TIMEOUT_MS=20000

# stdio (default) or http. --http on the command line forces http.
MCP_TRANSPORT=stdio
PORT=3000
